# ============================================================
# Sistema inteligente de asistencia, gestion y prediccion
# de incidencias tecnologicas en aulas
# Universidad Continental - sede Huancayo
# ------------------------------------------------------------
# NUNCA pongas valores institucionales reales en este archivo.
# Este archivo SI se versiona; el .env NO.
# ============================================================

APP_NAME="Asistencia de Incidencias"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=UTC

# Zona horaria de PRESENTACION (el almacenamiento siempre es UTC)
APP_DISPLAY_TIMEZONE=America/Lima

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# ------------------------------------------------------------
# BASE DE DATOS - MySQL/MariaDB via XAMPP (decision D-1)
# InnoDB + utf8mb4 obligatorios (plan 10.3)
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=incidencias
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

# Colas con driver database: sin Redis (plan 10.6)
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------
# IA LOCAL - proveedor intercambiable (plan 13.3)
# ollama | openai_compatible | fake | null
# El sistema DEBE funcionar completo con null.
# ------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Umbrales de confianza: se CALIBRAN empiricamente (plan 13.5).
# Vacios a proposito: no se inventan valores sin datos.
ASSISTANT_CONFIDENCE_HIGH=
ASSISTANT_CONFIDENCE_LOW=
ASSISTANT_MAX_DIAGNOSTIC_STEPS=8

# ------------------------------------------------------------
# RECUPERACION (RAG) - sin indice vectorial nativo en MariaDB 10.4
# mysql_inapp | mariadb_native | file
# ------------------------------------------------------------
VECTOR_STORE=mysql_inapp
RETRIEVAL_PREFILTER_LIMIT=300
RETRIEVAL_PREFILTER_MIN=20
RETRIEVAL_LATENCY_BUDGET_MS=800

# ------------------------------------------------------------
# BANCO DE IMAGENES (plan 13.6 y Anexo A)
# ------------------------------------------------------------
MEDIA_MAX_WIDTH=800
MEDIA_MAX_BYTES=153600
MEDIA_FORMAT=webp
MEDIA_STRIP_EXIF=true

# ------------------------------------------------------------
# ANTIABUSO (plan 16.4) - PROVISIONALES.
# Se calibran en la 1a semana del piloto con incident_abuse_rejections.
# ------------------------------------------------------------
ABUSE_DUPLICATE_WINDOW_MINUTES=15
ABUSE_MAX_ACTIVE_PER_ROOM=3
ABUSE_MAX_TICKETS_PER_DEVICE_HOUR=3
ABUSE_MAX_TICKETS_PER_IP_HOUR=30
ABUSE_MIN_FORM_SECONDS=3
ABUSE_SIMILARITY_THRESHOLD=0.85
DRAFT_PURGE_HOURS=24

# ------------------------------------------------------------
# MODULO PREDICTIVO (plan 15)
# ------------------------------------------------------------
RISK_HORIZON_DAYS=14
RISK_MODEL=baseline-recency

MAIL_MAILER=log

# Contrasena de los usuarios DEMO (solo desarrollo). Si se deja vacia,
# el seeder genera una aleatoria y la muestra una unica vez.
DEMO_USER_PASSWORD=
